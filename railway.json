{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "nixpacks",
    "buildCommand": "bundle exec rails tailwindcss:build",
    "watchPatterns": ["/**"]
  },
  "deploy": {
    "startCommand": "bin/rails db:prepare && bin/rails server -p $PORT -b 0.0.0.0",
    "healthcheckPath": "/",
    "restartPolicyType": "always"
  }
}
