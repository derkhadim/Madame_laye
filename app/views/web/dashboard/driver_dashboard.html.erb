<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
  <div class="bg-white rounded-xl shadow p-6">
    <div class="flex items-center gap-3">
      <div class="bg-green-100 p-3 rounded-full"><i class="fas fa-box text-green-600 text-xl"></i></div>
      <div>
        <p class="text-2xl font-bold"><%= @available_orders %></p>
        <p class="text-sm text-gray-500">Disponibles</p>
      </div>
    </div>
  </div>
  <div class="bg-white rounded-xl shadow p-6">
    <div class="flex items-center gap-3">
      <div class="bg-blue-100 p-3 rounded-full"><i class="fas fa-truck text-blue-600 text-xl"></i></div>
      <div>
        <p class="text-2xl font-bold"><%= @my_deliveries.count %></p>
        <p class="text-sm text-gray-500">Mes livraisons</p>
      </div>
    </div>
  </div>
  <div class="bg-white rounded-xl shadow p-6">
    <div class="flex items-center gap-3">
      <div class="bg-yellow-100 p-3 rounded-full"><i class="fas fa-wallet text-yellow-600 text-xl"></i></div>
      <div>
        <p class="text-2xl font-bold"><%= number_to_currency(@balance, unit: "CFA", format: "%n %u") %></p>
        <p class="text-sm text-gray-500">Solde</p>
      </div>
    </div>
  </div>
</div>

<div class="grid md:grid-cols-2 gap-6">
  <div class="bg-white rounded-xl shadow p-6">
    <h2 class="font-bold text-lg mb-4"><i class="fas fa-truck text-orange-600"></i> Mes livraisons</h2>
    <% if @my_deliveries.any? %>
      <div class="space-y-3">
        <% @my_deliveries.each do |order| %>
          <div class="border rounded-lg p-3">
            <div class="flex justify-between items-start">
              <div>
                <p class="font-medium"><%= order.cook.full_name %> → <%= order.customer.full_name %></p>
                <p class="text-sm text-gray-500"><%= order.delivery_address %></p>
              </div>
              <span class="text-xs px-2 py-0.5 rounded-full
                <%= 'bg-yellow-100 text-yellow-800' if order.driver_assigned? %>
                <%= 'bg-purple-100 text-purple-800' if order.in_delivery? %>
                <%= 'bg-green-100 text-green-800' if order.delivered? %>
              "><%= order.status.humanize %></span>
            </div>
            <% if order.driver_assigned? %>
              <a href="/orders/<%= order.id %>/accept_delivery" class="bg-purple-600 text-white px-3 py-1 rounded text-sm inline-block mt-2 hover:bg-purple-700">
                <i class="fas fa-check-circle"></i> Accepter la mission
              </a>
            <% elsif order.in_delivery? %>
              <a href="/orders/<%= order.id %>/mark_delivered" class="bg-green-500 text-white px-3 py-1 rounded text-sm inline-block mt-2 hover:bg-green-600"
                 data-turbo-method="post">
                <i class="fas fa-check-circle"></i> Marquer livré
              </a>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-500 text-center py-4">Aucune livraison assignée</p>
    <% end %>
    <a href="/deliveries" class="text-orange-600 hover:underline text-sm mt-2 inline-block">Voir toutes les commandes disponibles</a>
  </div>

  <div class="bg-white rounded-xl shadow p-6">
    <h2 class="font-bold text-lg mb-4"><i class="fas fa-wallet text-orange-600"></i> Solde & Retrait</h2>
    <div class="text-center py-6">
      <p class="text-4xl font-bold text-orange-600 mb-2"><%= number_to_currency(@balance, unit: "CFA", format: "%n %u") %></p>
      <p class="text-gray-500">Solde disponible</p>
    </div>
    <form action="/payments/withdrawal" method="post" class="flex gap-2">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
      <input type="number" name="amount" step="100" min="100" max="<%= @balance %>" placeholder="Montant" required
             class="flex-1 border rounded-lg px-3 py-2">
      <button type="submit" class="bg-orange-600 text-white px-4 py-2 rounded-lg hover:bg-orange-700">
        <i class="fas fa-money-bill-wave"></i> Retirer
      </button>
    </form>
  </div>
</div>
