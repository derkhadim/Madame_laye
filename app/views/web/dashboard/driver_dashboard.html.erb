<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
  <div class="card p-6 md:p-8">
    <div class="flex items-center gap-3">
      <div class="bg-green-100 p-3 rounded-full"><i class="fas fa-box text-green-600 text-xl"></i></div>
      <div>
        <p class="heading-2"><%= @available_orders %></p>
        <p class="text-gray-500 text-sm">Disponibles</p>
      </div>
    </div>
  </div>
  <div class="card p-6 md:p-8">
    <div class="flex items-center gap-3">
      <div class="bg-blue-100 p-3 rounded-full"><i class="fas fa-truck text-blue-600 text-xl"></i></div>
      <div>
        <p class="heading-2"><%= @my_deliveries.count %></p>
        <p class="text-gray-500 text-sm">Mes livraisons</p>
      </div>
    </div>
  </div>
  <div class="card p-6 md:p-8">
    <div class="flex items-center gap-3">
      <div class="bg-yellow-100 p-3 rounded-full"><i class="fas fa-wallet text-yellow-600 text-xl"></i></div>
      <div>
        <p class="heading-2"><%= number_to_currency(@balance, unit: "CFA", format: "%n %u") %></p>
        <p class="text-gray-500 text-sm">Solde</p>
      </div>
    </div>
  </div>
</div>

<div class="grid md:grid-cols-2 gap-6">
  <div class="card">
    <div class="card-header">
      <h2 class="heading-3"><i class="fas fa-truck text-primary"></i> Mes livraisons</h2>
    </div>
    <div class="card-body">
      <% if @my_deliveries.any? %>
        <div class="space-y-3">
          <% @my_deliveries.each do |order| %>
            <div class="border rounded-lg p-3">
              <div class="flex justify-between items-start">
                <div>
                  <p class="font-medium"><%= order.cook.full_name %> → <%= order.customer.full_name %></p>
                  <p class="text-gray-500 text-sm"><%= order.delivery_address %></p>
                </div>
                <span class="badge <%= 'badge-secondary' if order.driver_assigned? %><%= 'badge-secondary' if order.in_delivery? %><%= 'badge-secondary' if order.delivered? %>"><%= order.status.humanize %></span>
              </div>
              <% if order.driver_assigned? %>
                <a href="/orders/<%= order.id %>/accept_delivery" class="btn btn-sm mt-2" style="background-color:#9333ea;color:white;border:none">
                  <i class="fas fa-check-circle"></i> Accepter la mission
                </a>
              <% elsif order.in_delivery? %>
                <a href="/orders/<%= order.id %>/mark_delivered" class="btn btn-sm mt-2" style="background-color:#16a34a;color:white;border:none"
                   data-turbo-method="post">
                  <i class="fas fa-check-circle"></i> Marquer livré
                </a>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-500 text-center py-4">Aucune livraison assignée</p>
      <% end %>
      <a href="/deliveries" class="text-primary hover:underline text-sm mt-2 inline-block">Voir toutes les commandes disponibles</a>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <h2 class="heading-3"><i class="fas fa-wallet text-primary"></i> Solde & Retrait</h2>
    </div>
    <div class="card-body">
      <div class="text-center py-6">
        <p class="heading-1 text-primary mb-2"><%= number_to_currency(@balance, unit: "CFA", format: "%n %u") %></p>
        <p class="text-gray-500">Solde disponible</p>
      </div>
      <form action="/payments/withdrawal" method="post" class="flex gap-2">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <input type="number" name="amount" step="100" min="100" max="<%= @balance %>" placeholder="Montant" required class="input flex-1">
        <button type="submit" class="btn btn-primary">
          <i class="fas fa-money-bill-wave"></i> Retirer
        </button>
      </form>
    </div>
  </div>
</div>
