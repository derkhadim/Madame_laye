<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
  <div class="card p-6 md:p-8">
    <div class="flex items-center gap-3">
      <div class="bg-muted p-3 rounded-full"><i class="fas fa-spinner text-primary text-xl"></i></div>
      <div>
        <p class="heading-2"><%= @active_orders.count %></p>
        <p class="text-gray-500 text-sm">Commandes actives</p>
      </div>
    </div>
  </div>
  <div class="card p-6 md:p-8">
    <div class="flex items-center gap-3">
      <div class="bg-green-100 p-3 rounded-full"><i class="fas fa-check-circle text-green-600 text-xl"></i></div>
      <div>
        <p class="heading-2"><%= @order_history.count %></p>
        <p class="text-gray-500 text-sm">Commandes livrées</p>
      </div>
    </div>
  </div>
  <div class="card p-6 md:p-8">
    <div class="flex items-center gap-3">
      <div class="bg-blue-100 p-3 rounded-full"><i class="fas fa-search text-blue-600 text-xl"></i></div>
      <div>
        <a href="/menus/search" class="heading-3 hover:underline text-primary">Rechercher</a>
        <p class="text-gray-500 text-sm">Trouver un repas</p>
      </div>
    </div>
  </div>
</div>

<div class="grid md:grid-cols-2 gap-6">
  <div class="card">
    <div class="card-header">
      <h2 class="heading-3"><i class="fas fa-hourglass-half text-primary"></i> Commandes en cours</h2>
    </div>
    <div class="card-body">
      <% if @active_orders.any? %>
        <div class="space-y-3">
          <% @active_orders.each do |order| %>
            <div class="border rounded-lg p-3">
              <div class="flex justify-between items-start">
                <div>
                  <p class="font-medium"><%= order.cook.full_name %></p>
                  <p class="text-gray-500 text-sm"><%= order.order_items.count %> article(s) · <%= number_to_currency(order.total_amount, unit: "CFA", format: "%n %u") %></p>
                </div>
                <span class="badge <%= 'badge-secondary' if order.pending? %><%= 'badge-primary' if order.accepted? %><%= 'badge-secondary' if order.in_delivery? %><%= 'badge-secondary' if order.delivered? %>"><%= order.status %></span>
              </div>
              <a href="/orders/<%= order.id %>" class="text-primary text-sm hover:underline mt-2 inline-block">Détails</a>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-500 text-center py-4"><i class="fas fa-inbox"></i> Aucune commande active</p>
      <% end %>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <h2 class="heading-3"><i class="fas fa-history text-gray-500"></i> Historique</h2>
    </div>
    <div class="card-body">
      <% if @order_history.any? %>
        <div class="space-y-2">
          <% @order_history.each do |order| %>
            <div class="border-b pb-2 flex justify-between">
              <span class="text-sm"><%= order.cook.full_name %></span>
              <span class="text-gray-500 text-sm"><%= number_to_currency(order.total_amount, unit: "CFA", format: "%n %u") %></span>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-500 text-center py-4">Aucun historique</p>
      <% end %>
    </div>
  </div>
</div>
