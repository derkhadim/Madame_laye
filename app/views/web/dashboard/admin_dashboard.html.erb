<div class="grid grid-cols-1 md:grid-cols-5 gap-6 mb-8">
  <div class="card p-6 md:p-8">
    <p class="heading-2 text-primary"><%= @total_cooks %></p>
    <p class="text-gray-500 text-sm">Cuisiniers</p>
  </div>
  <div class="card p-6 md:p-8">
    <p class="heading-2" style="color:#2563eb"><%= @total_clients %></p>
    <p class="text-gray-500 text-sm">Clients</p>
  </div>
  <div class="card p-6 md:p-8">
    <p class="heading-2" style="color:#16a34a"><%= @total_drivers %></p>
    <p class="text-gray-500 text-sm">Livreurs</p>
  </div>
  <div class="card p-6 md:p-8">
    <p class="heading-2" style="color:#9333ea"><%= @total_orders %></p>
    <p class="text-gray-500 text-sm">Commandes total</p>
  </div>
  <div class="card p-6 md:p-8">
    <p class="heading-2" style="color:#ca8a04"><%= @pending_orders %></p>
    <p class="text-gray-500 text-sm">En attente</p>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h2 class="heading-3"><i class="fas fa-users text-primary"></i> Gestion des utilisateurs</h2>
  </div>
  <div class="card-body p-0">
    <div class="table-container">
      <table>
        <thead>
          <tr><th>Nom</th><th>Téléphone</th><th>Rôle</th><th>Statut</th></tr>
        </thead>
        <tbody>
          <% User.order(created_at: :desc).limit(20).each do |u| %>
            <tr>
              <td><%= u.full_name %></td>
              <td><%= u.phone_number %></td>
              <td><span class="badge badge-secondary"><%= u.role %></span></td>
              <td><%= u.status %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
