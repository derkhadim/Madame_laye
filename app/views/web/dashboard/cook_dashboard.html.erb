<div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
  <div class="bg-white rounded-xl shadow p-6">
    <div class="flex items-center gap-3">
      <div class="bg-orange-100 p-3 rounded-full"><i class="fas fa-clock text-orange-600 text-xl"></i></div>
      <div>
        <p class="text-2xl font-bold"><%= @pending_orders %></p>
        <p class="text-sm text-gray-500">En attente</p>
      </div>
    </div>
  </div>
  <div class="bg-white rounded-xl shadow p-6">
    <div class="flex items-center gap-3">
      <div class="bg-blue-100 p-3 rounded-full"><i class="fas fa-spinner text-blue-600 text-xl"></i></div>
      <div>
        <p class="text-2xl font-bold"><%= @in_progress_orders %></p>
        <p class="text-sm text-gray-500">En cours</p>
      </div>
    </div>
  </div>
  <div class="bg-white rounded-xl shadow p-6">
    <div class="flex items-center gap-3">
      <div class="bg-green-100 p-3 rounded-full"><i class="fas fa-utensils text-green-600 text-xl"></i></div>
      <div>
        <p class="text-2xl font-bold"><%= @today_meals %></p>
        <p class="text-sm text-gray-500">Plats dispo</p>
      </div>
    </div>
  </div>
  <div class="bg-white rounded-xl shadow p-6">
    <div class="flex items-center gap-3">
      <div class="bg-yellow-100 p-3 rounded-full"><i class="fas fa-truck text-yellow-600 text-xl"></i></div>
      <div>
        <p class="text-2xl font-bold"><%= @today_orders.count %></p>
        <p class="text-sm text-gray-500">Commandes jour</p>
      </div>
    </div>
  </div>
</div>

<div class="grid md:grid-cols-2 gap-6">
  <div class="bg-white rounded-xl shadow p-6">
    <h2 class="font-bold text-lg mb-4"><i class="fas fa-shopping-cart text-orange-600"></i> Commandes du jour</h2>
    <% if @today_orders.any? %>
      <div class="space-y-3">
        <% @today_orders.each do |order| %>
          <div class="border rounded-lg p-3 flex justify-between items-center">
            <div>
              <p class="font-medium"><%= order.customer.full_name %></p>
              <p class="text-sm text-gray-500"><%= order.order_items.count %> article(s) · <%= number_to_currency(order.total_amount, unit: "CFA", format: "%n %u") %></p>
              <span class="text-xs px-2 py-0.5 rounded-full
                <%= 'bg-yellow-100 text-yellow-800' if order.pending? %>
                <%= 'bg-blue-100 text-blue-800' if order.accepted? %>
                <%= 'bg-purple-100 text-purple-800' if order.in_delivery? %>
              "><%= order.status %></span>
            </div>
            <div class="flex gap-2">
              <% if order.pending? %>
                <a href="/orders/<%= order.id %>/accept" class="bg-green-500 text-white px-3 py-1 rounded text-sm hover:bg-green-600">
                  <i class="fas fa-check"></i>
                </a>
              <% elsif order.accepted? %>
                <a href="/orders/<%= order.id %>/assign" class="bg-purple-500 text-white px-3 py-1 rounded text-sm hover:bg-purple-600">
                  <i class="fas fa-truck"></i>
                </a>
              <% end %>
              <a href="/orders/<%= order.id %>" class="bg-gray-200 text-gray-700 px-3 py-1 rounded text-sm hover:bg-gray-300">
                <i class="fas fa-eye"></i>
              </a>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-500 text-center py-4"><i class="fas fa-inbox"></i> Aucune commande aujourd'hui</p>
    <% end %>
  </div>

  <div>
    <div class="bg-white rounded-xl shadow p-6 mb-6">
      <h2 class="font-bold text-lg mb-4"><i class="fas fa-calendar-week text-orange-600"></i> Actions rapides</h2>
      <div class="space-y-3">
        <a href="/meals/new" class="block bg-orange-50 border border-orange-200 rounded-lg p-3 hover:bg-orange-100">
          <i class="fas fa-plus-circle text-orange-600"></i> Ajouter un plat de la semaine
        </a>
        <a href="/daily_products/new" class="block bg-blue-50 border border-blue-200 rounded-lg p-3 hover:bg-blue-100">
          <i class="fas fa-box-open text-blue-600"></i> Poster un produit journalier
        </a>
        <a href="/orders" class="block bg-gray-50 border border-gray-200 rounded-lg p-3 hover:bg-gray-100">
          <i class="fas fa-list text-gray-600"></i> Voir toutes les commandes
        </a>
      </div>
    </div>
  </div>
</div>
