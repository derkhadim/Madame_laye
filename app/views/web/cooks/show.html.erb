<div class="max-w-4xl mx-auto">
  <a href="/menus/search" class="text-primary hover:underline mb-4 inline-block"><i class="fas fa-arrow-left"></i> Retour à la recherche</a>

  <div class="card overflow-hidden mb-6">
    <div class="bg-muted p-6">
      <div class="flex items-center gap-4">
        <div class="w-16 h-16 bg-muted rounded-full flex items-center justify-center text-2xl font-bold">
          <%= @cook.full_name.split.map(&:first).join %>
        </div>
        <div>
          <h1 class="heading-2"><%= @cook.full_name %></h1>
          <p class="text-gray-500"><i class="fas fa-map-marker-alt"></i> <%= @cook.address %></p>
        </div>
      </div>
    </div>
  </div>

  <div class="card overflow-hidden mb-6">
    <div class="card-header bg-muted/50">
      <h2 class="heading-3"><i class="fas fa-utensils text-primary"></i> Aujourd'hui — <%= Date.current.strftime('%A').capitalize %></h2>
    </div>
    <div class="card-body grid md:grid-cols-2 gap-4">
      <% today = Date.current.strftime("%A").downcase %>
      <% lunch = @weekly_meals.select { |m| m.day_of_week == today && m.lunch? && m.available? }.first %>
      <% dinner = @weekly_meals.select { |m| m.day_of_week == today && m.dinner? && m.available? }.first %>

      <% if lunch %>
        <div class="border rounded-lg p-4">
          <div class="flex justify-between items-start mb-2">
            <div>
              <h3 class="font-bold"><%= lunch.name %></h3>
              <p class="text-gray-500 text-xs"><%= lunch.description&.truncate(60) %></p>
            </div>
            <span class="badge badge-secondary">Déjeuner</span>
          </div>
          <div class="flex justify-between items-center mt-3">
            <span class="text-lg font-bold text-primary"><%= number_to_currency(lunch.price, unit: "CFA", format: "%n %u") %></span>
            <% if current_user&.client? %>
              <a href="/clients/<%= @cook.id %>/order/meal/<%= lunch.id %>" class="btn btn-primary btn-sm">
                <i class="fas fa-shopping-cart"></i> Commander
              </a>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if dinner %>
        <div class="border rounded-lg p-4">
          <div class="flex justify-between items-start mb-2">
            <div>
              <h3 class="font-bold"><%= dinner.name %></h3>
              <p class="text-gray-500 text-xs"><%= dinner.description&.truncate(60) %></p>
            </div>
            <span class="badge badge-primary">Dîner</span>
          </div>
          <div class="flex justify-between items-center mt-3">
            <span class="text-lg font-bold text-primary"><%= number_to_currency(dinner.price, unit: "CFA", format: "%n %u") %></span>
            <% if current_user&.client? %>
              <a href="/clients/<%= @cook.id %>/order/meal/<%= dinner.id %>" class="btn btn-primary btn-sm">
                <i class="fas fa-shopping-cart"></i> Commander
              </a>
            <% end %>
          </div>
        </div>
      <% end %>

      <% unless lunch || dinner %>
        <div class="md:col-span-2 text-center py-6 bg-muted rounded-lg">
          <i class="fas fa-utensils text-3xl text-gray-500 mb-2"></i>
          <p class="text-gray-500">Aucun plat disponible aujourd'hui</p>
        </div>
      <% end %>
    </div>
  </div>

  <div class="card overflow-hidden mb-6">
    <div class="card-header bg-muted/50">
      <h2 class="heading-3"><i class="fas fa-calendar-week text-primary"></i> Menu de la semaine</h2>
    </div>
    <div class="table-container">
      <table>
        <thead>
          <tr><th>Jour</th><th>Déjeuner</th><th>Dîner</th></tr>
        </thead>
        <tbody>
          <% %w[monday tuesday wednesday thursday friday saturday sunday].each do |day| %>
            <% l = @weekly_meals.select { |m| m.day_of_week == day && m.lunch? }.first %>
            <% d = @weekly_meals.select { |m| m.day_of_week == day && m.dinner? }.first %>
            <tr class="<%= day == today ? 'bg-muted' : '' %>">
              <td class="font-medium">
                <%= day.capitalize %>
                <% if day == today %>
                  <span class="badge badge-primary text-xs ml-1">Aujourd'hui</span>
                <% end %>
              </td>
              <td>
                <% if l&.available? %>
                  <span class="font-medium"><%= l.name %></span>
                  <p class="text-xs text-primary"><%= number_to_currency(l.price, unit: "CFA", format: "%n %u") %></p>
                <% else %>
                  <span class="text-gray-500">—</span>
                <% end %>
              </td>
              <td>
                <% if d&.available? %>
                  <span class="font-medium"><%= d.name %></span>
                  <p class="text-xs text-primary"><%= number_to_currency(d.price, unit: "CFA", format: "%n %u") %></p>
                <% else %>
                  <span class="text-gray-500">—</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="card overflow-hidden mb-6">
    <div class="card-header bg-muted/50">
      <h2 class="heading-3"><i class="fas fa-box text-primary"></i> Produits du jour</h2>
    </div>
    <% if @daily_products.any? %>
      <div class="card-body grid grid-cols-1 md:grid-cols-3 gap-4">
        <% @daily_products.each do |p| %>
          <div class="border rounded-lg p-3">
            <div class="flex justify-between items-start mb-2">
              <span class="badge <%= 'badge-secondary' if p.petit_fours? %><%= 'badge-primary' if p.plat_sale? %><%= 'badge-secondary' if p.gateaux? %>"><%= p.category.humanize %></span>
              <span class="text-xs text-gray-500"><%= p.quantity_available %> dispo</span>
            </div>
            <h4 class="font-medium"><%= p.name %></h4>
            <p class="text-gray-500 text-xs mb-2"><%= p.description&.truncate(60) %></p>
            <div class="flex justify-between items-center mt-2">
              <span class="text-primary font-bold"><%= number_to_currency(p.price, unit: "CFA", format: "%n %u") %></span>
              <% if current_user&.client? %>
                <a href="/clients/<%= @cook.id %>/order/product/<%= p.id %>" class="btn btn-primary btn-sm">
                  <i class="fas fa-shopping-cart"></i> Commander
                </a>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-500 text-center py-6"><i class="fas fa-box-open"></i> Aucun produit disponible aujourd'hui</p>
    <% end %>
  </div>
</div>
