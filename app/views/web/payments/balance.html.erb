<div class="max-w-lg mx-auto card p-6 md:p-8">
  <div class="card-header text-center">
    <h1 class="heading-2"><i class="fas fa-wallet text-primary"></i> Mon solde</h1>
  </div>
  <div class="card-body">
    <div class="text-center py-8">
      <p class="heading-1 text-primary mb-2"><%= number_to_currency(@balance, unit: "CFA", format: "%n %u") %></p>
      <p class="text-gray-500">Solde disponible</p>
      <% if @pending_withdrawals > 0 %>
        <p class="text-sm" style="color:#ca8a04"><i class="fas fa-clock"></i> <%= number_to_currency(@pending_withdrawals, unit: "CFA", format: "%n %u") %> en attente de validation</p>
      <% end %>
    </div>

    <form action="/payments/withdrawal" method="post" class="space-y-4">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
      <div>
        <label class="label">Montant à retirer</label>
        <input type="number" name="amount" step="100" min="100" max="<%= @balance - @pending_withdrawals %>" required class="input">
      </div>
      <button type="submit" class="btn w-full" style="background-color:#16a34a;color:white;border:none">
        <i class="fas fa-money-bill-wave"></i> Demander un retrait
      </button>
    </form>

    <div class="mt-6 text-center">
      <a href="/withdrawals" class="text-primary hover:underline text-sm">
        <i class="fas fa-history"></i> Voir l'historique des retraits
      </a>
    </div>

    <a href="/dashboard" class="block text-center mt-4 text-primary hover:underline text-sm">
      <i class="fas fa-arrow-left"></i> Retour au tableau de bord
    </a>
  </div>
</div>
