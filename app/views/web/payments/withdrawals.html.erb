<div class="max-w-2xl mx-auto">
  <a href="/payments/balance" class="text-primary hover:underline mb-4 inline-block"><i class="fas fa-arrow-left"></i> Retour au solde</a>

  <div class="card overflow-hidden">
    <div class="bg-muted p-6">
      <h1 class="heading-3"><i class="fas fa-history"></i> Historique des retraits</h1>
    </div>

    <% if @withdrawals.any? %>
      <div class="table-container">
        <table>
          <thead>
            <tr><th>Date</th><th>Montant</th><th>Statut</th><th>Traité le</th></tr>
          </thead>
          <tbody>
            <% @withdrawals.each do |w| %>
              <tr>
                <td><%= l(w.created_at, format: :short) %></td>
                <td class="font-bold"><%= number_to_currency(w.amount, unit: "CFA", format: "%n %u") %></td>
                <td>
                  <% if w.pending? %>
                    <span class="badge" style="background-color:#fef3c7;color:#854d0e"><i class="fas fa-clock"></i> En cours de traitement</span>
                  <% else %>
                    <span class="badge" style="background-color:#dcfce7;color:#166534"><i class="fas fa-check-circle"></i> Validé</span>
                  <% end %>
                </td>
                <td><%= w.processed_at ? l(w.processed_at, format: :short) : "—" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-12">
        <i class="fas fa-receipt text-4xl text-gray-500 mb-3"></i>
        <p class="text-gray-500">Aucun retrait pour le moment</p>
        <a href="/payments/balance" class="text-primary hover:underline text-sm">Effectuer un retrait</a>
      </div>
    <% end %>
  </div>
</div>
