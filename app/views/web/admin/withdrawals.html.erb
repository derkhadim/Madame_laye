<div class="max-w-4xl mx-auto">
  <a href="/admin" class="text-primary hover:underline mb-4 inline-block"><i class="fas fa-arrow-left"></i> Retour à l'administration</a>

  <div class="card overflow-hidden">
    <div class="bg-muted p-6">
      <h1 class="heading-3"><i class="fas fa-money-bill-wave"></i> Gestion des retraits</h1>
      <p class="opacity-80 text-sm"><%= @withdrawals.count %> demande(s) en attente</p>
    </div>

    <% if @withdrawals.any? %>
      <div class="table-container">
        <table>
          <thead>
            <tr><th>Date</th><th>Livreur</th><th>Téléphone</th><th>Montant</th><th>Solde actuel</th><th>Actions</th></tr>
          </thead>
          <tbody>
            <% @withdrawals.each do |w| %>
              <tr>
                <td><%= l(w.created_at, format: :short) %></td>
                <td class="font-medium"><%= w.user.full_name %></td>
                <td><%= w.user.phone_number %></td>
                <td class="font-bold text-primary"><%= number_to_currency(w.amount, unit: "CFA", format: "%n %u") %></td>
                <td><%= number_to_currency(w.user.balance, unit: "CFA", format: "%n %u") %></td>
                <td>
                  <% if w.user.balance >= w.amount %>
                    <a href="/admin/withdrawals/<%= w.id %>/validate"
                       class="btn btn-sm" style="background-color:#16a34a;color:white;border:none"
                       data-confirm="Valider le retrait de <%= number_to_currency(w.amount, unit: 'CFA', format: '%n %u') %> pour <%= w.user.full_name %> ?">
                      <i class="fas fa-check"></i> Valider
                    </a>
                  <% else %>
                    <span class="text-destructive text-xs"><i class="fas fa-exclamation-triangle"></i> Solde insuffisant</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-12">
        <i class="fas fa-check-circle text-4xl" style="color:#86efac"></i>
        <p class="text-gray-500">Aucune demande de retrait en attente</p>
      </div>
    <% end %>
  </div>
</div>
