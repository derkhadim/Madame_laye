<div class="grid md:grid-cols-2 gap-6">
  <div class="bg-white rounded-xl shadow p-6">
    <h2 class="font-bold text-lg mb-4"><i class="fas fa-box text-green-600"></i> Commandes disponibles</h2>
    <% if @available.any? %>
      <div class="space-y-3">
        <% @available.each do |order| %>
          <div class="border rounded-lg p-3">
            <div class="flex justify-between items-start">
              <div>
                <p class="font-medium"><%= order.cook.full_name %> → <%= order.customer.full_name %></p>
                <p class="text-sm text-gray-500"><%= order.delivery_address %></p>
                <p class="text-sm font-medium"><%= number_to_currency(order.total_amount, unit: "CFA", format: "%n %u") %></p>
              </div>
              <a href="/deliveries/<%= order.id %>/take" class="bg-green-600 text-white px-3 py-1 rounded text-sm hover:bg-green-700"
                 data-turbo-method="post">
                <i class="fas fa-hand-paper"></i> Prendre
              </a>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-500 text-center py-4"><i class="fas fa-inbox"></i> Aucune commande disponible</p>
    <% end %>
  </div>

  <div class="bg-white rounded-xl shadow p-6">
    <h2 class="font-bold text-lg mb-4"><i class="fas fa-truck text-blue-600"></i> Mes livraisons en cours</h2>
    <% if @my_deliveries.any? %>
      <div class="space-y-3">
        <% @my_deliveries.each do |order| %>
          <div class="border rounded-lg p-3">
            <div class="flex justify-between items-start">
              <div>
                <p class="font-medium"><%= order.cook.full_name %></p>
                <p class="text-sm text-gray-500"><%= order.delivery_address %></p>
                <span class="text-xs px-2 py-0.5 rounded-full
                  <%= 'bg-purple-100 text-purple-800' if order.in_delivery? %>
                  <%= 'bg-green-100 text-green-800' if order.delivered? %>
                "><%= order.status %></span>
              </div>
              <% if order.in_delivery? %>
                <a href="/orders/<%= order.id %>/mark_delivered" class="bg-green-600 text-white px-3 py-1 rounded text-sm hover:bg-green-700">
                  <i class="fas fa-check-circle"></i> Livrer
                </a>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-500 text-center py-4">Aucune livraison en cours</p>
    <% end %>
  </div>
</div>
