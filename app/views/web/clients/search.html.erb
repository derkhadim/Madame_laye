<div class="max-w-4xl mx-auto">
  <h1 class="heading-2 mb-24 pt-8 mt-10"><i class="fas fa-search text-primary"></i> Rechercher un repas</h1>

  <div class="card p-2 md:p-5 mb-10">
    <form action="/menus/search" method="get" class="grid md:grid-cols-4 gap-6">
      <div class="md:col-span-2">
        <label class="label">Mot-clé</label>
        <input type="text" name="keyword" value="<%= params[:keyword] %>" autofocus class="input" placeholder="Poulet, Mafé...">
      </div>
      <div>
        <label class="label">Type de plat</label>
        <select name="meal_type" class="select">
          <option value="">Tous</option>
          <option value="lunch" <%= 'selected' if params[:meal_type] == 'lunch' %>>Déjeuner</option>
          <option value="dinner" <%= 'selected' if params[:meal_type] == 'dinner' %>>Dîner</option>
        </select>
      </div>
      <div class="flex items-end">
        <button type="submit" class="btn btn-primary w-full">
          <i class="fas fa-search"></i> Chercher
        </button>
      </div>
    </form>
  </div>

  <% if @results.present? %>
    <% if params[:keyword].blank? %>
      <p class="text-gray-500 text-sm mb-4"><i class="fas fa-star" style="color:#eab308"></i> Quelques plats du jour — utilisez la recherche ci-dessus pour trouver le vôtre</p>
    <% end %>

    <div class="space-y-4">
      <% @results.each do |r| %>
        <div class="card overflow-hidden">
          <div class="bg-muted p-4">
            <div class="flex justify-between items-center">
              <div>
                <h3 class="font-bold text-lg">
                  <a href="/cooks/<%= r[:cook].id %>" class="hover:text-primary">
                    <%= r[:cook].full_name %> <i class="fas fa-external-link-alt text-xs text-gray-500"></i>
                  </a>
                </h3>
                <p class="text-gray-500 text-sm"><i class="fas fa-map-marker-alt"></i> <%= r[:cook].address %></p>
              </div>
              <div class="flex gap-2">
                <% if r[:meals].any? %>
                  <span class="badge badge-outline"><%= r[:meals].count %> plat(s)</span>
                <% end %>
              </div>
            </div>
          </div>

          <div class="p-4 space-y-4">
            <% if r[:meals].any? %>
              <div class="grid md:grid-cols-2 gap-3">
                <% r[:meals].each do |meal| %>
                  <div class="rounded-lg p-3" style="border: 1px solid #eee">
                    <div class="flex justify-between items-start mb-2">
                      <h4 class="font-medium"><%= meal.name %></h4>
                      <span class="badge <%= meal.lunch? ? 'badge-secondary' : 'badge-outline' %>"><%= meal.lunch? ? "Déjeuner" : "Dîner" %></span>
                    </div>
                    <p class="text-gray-500 text-sm mb-2"><%= meal.description&.truncate(80) %></p>
                    <div class="flex justify-between items-center">
                      <span class="text-lg font-bold text-primary"><%= number_to_currency(meal.price, unit: "CFA", format: "%n %u") %></span>
                      <a href="/clients/<%= r[:cook].id %>/order/meal/<%= meal.id %>" class="btn btn-primary btn-sm">
                        <i class="fas fa-shopping-cart"></i> Commander
                      </a>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% elsif params[:keyword].present? %>
    <div class="text-center py-12 card">
      <i class="fas fa-search text-4xl text-gray-500 mb-3"></i>
      <p class="text-gray-500">Aucun résultat pour "<%= params[:keyword] %>"</p>
    </div>
  <% else %>
    <div class="text-center py-12 card">
      <i class="fas fa-utensils text-4xl text-gray-500 mb-3"></i>
      <p class="text-gray-500">Tapez le nom d'un plat pour commencer la recherche</p>
    </div>
  <% end %>
</div>
