<div class="max-w-4xl mx-auto">
  <h1 class="text-2xl font-bold mb-6"><i class="fas fa-search text-orange-600"></i> Rechercher un repas ou un produit</h1>

  <div class="bg-white rounded-xl shadow p-6 mb-6">
    <form action="/menus/search" method="get" class="grid md:grid-cols-4 gap-4">
      <div class="md:col-span-2">
        <label class="block text-sm font-medium text-gray-700 mb-1">Mot-clé</label>
        <input type="text" name="keyword" value="<%= params[:keyword] %>" autofocus
               class="w-full border rounded-lg px-3 py-2" placeholder="Poulet, Mafé, Samoussas...">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Type de plat</label>
        <select name="meal_type" class="w-full border rounded-lg px-3 py-2">
          <option value="">Tous</option>
          <option value="lunch" <%= 'selected' if params[:meal_type] == 'lunch' %>>Déjeuner</option>
          <option value="dinner" <%= 'selected' if params[:meal_type] == 'dinner' %>>Dîner</option>
        </select>
      </div>
      <div class="flex items-end">
        <button type="submit" class="bg-orange-600 text-white px-4 py-2 rounded-lg hover:bg-orange-700 w-full">
          <i class="fas fa-search"></i> Chercher
        </button>
      </div>
    </form>
  </div>

  <% if @results.present? %>
    <% if params[:keyword].blank? %>
      <p class="text-sm text-gray-500 mb-4"><i class="fas fa-star text-yellow-500"></i> Quelques plats du jour — utilisez la recherche ci-dessus pour trouver le vôtre</p>
    <% end %>

    <div class="space-y-4">
      <% @results.each do |r| %>
        <div class="bg-white rounded-xl shadow overflow-hidden">
          <div class="bg-orange-50 p-4 border-b">
            <div class="flex justify-between items-center">
              <div>
                <h3 class="font-bold text-lg">
                  <a href="/cooks/<%= r[:cook].id %>" class="hover:text-orange-600">
                    <%= r[:cook].full_name %> <i class="fas fa-external-link-alt text-xs text-gray-400"></i>
                  </a>
                </h3>
                <p class="text-sm text-gray-500"><i class="fas fa-map-marker-alt"></i> <%= r[:cook].address %></p>
              </div>
              <div class="flex gap-2">
                <% if r[:meals].any? %>
                  <span class="bg-orange-600 text-white text-xs px-2 py-1 rounded"><%= r[:meals].count %> plat(s)</span>
                <% end %>
                <% if r[:products].any? %>
                  <span class="bg-green-600 text-white text-xs px-2 py-1 rounded"><%= r[:products].count %> produit(s)</span>
                <% end %>
              </div>
            </div>
          </div>

          <div class="p-4 space-y-4">
            <% if r[:meals].any? %>
              <div class="grid md:grid-cols-2 gap-3">
                <% r[:meals].each do |meal| %>
                  <div class="border rounded-lg p-3 hover:shadow-md transition">
                    <div class="flex justify-between items-start mb-2">
                      <h4 class="font-medium"><%= meal.name %></h4>
                        <span class="text-xs px-2 py-0.5 rounded-full font-medium
                          <%= meal.lunch? ? 'bg-yellow-100 text-yellow-800' : 'bg-blue-100 text-blue-800' %>
                        "><%= meal.lunch? ? "Déjeuner" : "Dîner" %></span>
                    </div>
                    <p class="text-sm text-gray-500 mb-2"><%= meal.description&.truncate(80) %></p>
                    <div class="flex justify-between items-center">
                      <span class="text-lg font-bold text-orange-600"><%= number_to_currency(meal.price, unit: "CFA", format: "%n %u") %></span>
                      <a href="/clients/<%= r[:cook].id %>/order/meal/<%= meal.id %>"
                         class="bg-orange-600 text-white px-3 py-1.5 rounded text-sm hover:bg-orange-700">
                        <i class="fas fa-shopping-cart"></i> Commander
                      </a>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>

            <% if r[:products].any? %>
              <div>
                <h4 class="text-sm font-semibold text-gray-600 mb-2"><i class="fas fa-box text-green-600"></i> Produits du jour</h4>
                <div class="grid md:grid-cols-2 gap-3">
                  <% r[:products].each do |p| %>
                    <div class="border rounded-lg p-3 hover:shadow-md transition">
                      <div class="flex justify-between items-start mb-2">
                        <h4 class="font-medium"><%= p.name %></h4>
                        <span class="text-xs px-2 py-0.5 rounded-full
                          <%= 'bg-pink-100 text-pink-800' if p.petit_fours? %>
                          <%= 'bg-green-100 text-green-800' if p.plat_sale? %>
                          <%= 'bg-yellow-100 text-yellow-800' if p.gateaux? %>
                        "><%= p.category.humanize %></span>
                      </div>
                      <p class="text-sm text-gray-500 mb-2"><%= p.description&.truncate(60) %></p>
                      <div class="flex justify-between items-center">
                        <span class="text-lg font-bold text-orange-600"><%= number_to_currency(p.price, unit: "CFA", format: "%n %u") %></span>
                        <a href="/clients/<%= r[:cook].id %>/order/product/<%= p.id %>"
                           class="bg-orange-600 text-white px-3 py-1.5 rounded text-sm hover:bg-orange-700">
                          <i class="fas fa-shopping-cart"></i> Commander
                        </a>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% elsif params[:keyword].present? %>
    <div class="text-center py-12 bg-white rounded-xl shadow">
      <i class="fas fa-search text-4xl text-gray-300 mb-3"></i>
      <p class="text-gray-500">Aucun résultat pour "<%= params[:keyword] %>"</p>
    </div>
  <% else %>
    <div class="text-center py-12 bg-white rounded-xl shadow">
      <i class="fas fa-utensils text-4xl text-gray-300 mb-3"></i>
      <p class="text-gray-500">Tapez le nom d'un plat ou d'un produit pour commencer la recherche</p>
    </div>
  <% end %>
</div>
