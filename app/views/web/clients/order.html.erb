<div class="max-w-lg mx-auto">
  <a href="/cooks/<%= @cook.id %>" class="text-primary hover:underline mb-4 inline-block"><i class="fas fa-arrow-left"></i> Retour au profil</a>

  <div class="card overflow-hidden">
    <div class="bg-muted p-8">
      <h1 class="heading-3">Commander chez <%= @cook.full_name %></h1>
      <p class="opacity-80 text-sm"><i class="fas fa-map-marker-alt"></i> <%= @cook.address %></p>
    </div>

    <div class="card-body">
      <div class="border rounded-lg p-4 mb-6 bg-muted">
        <div class="flex justify-between items-start mb-2">
          <div>
            <h3 class="font-bold"><%= @item.name %></h3>
            <p class="text-gray-500 text-sm"><%= @item.description %></p>
          </div>
          <span class="badge <%= 'badge-secondary' if @item.is_a?(Meal) && @item.lunch? %><%= 'badge-primary' if @item.is_a?(Meal) && @item.dinner? %><%= 'badge-secondary' if @item.is_a?(DailyProduct) %>">
            <% if @item.is_a?(Meal) %>
              <%= @item.lunch? ? "Déjeuner" : "Dîner" %>
            <% else %>
              <%= @item.category.humanize %>
            <% end %>
          </span>
        </div>
        <p class="text-lg font-bold text-primary"><%= number_to_currency(@item.price, unit: "CFA", format: "%n %u") %></p>
      </div>

      <form action="/clients/<%= @cook.id %>/order" method="post" class="space-y-4">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <input type="hidden" name="item_type" value="<%= params[:item_type] %>">
        <input type="hidden" name="item_id" value="<%= @item.id %>">

        <div>
          <label class="label">Quantité</label>
          <% max_qty = @item.is_a?(DailyProduct) ? @item.quantity_available : (@item.portion_count || 10) %>
          <select name="quantity" class="select" onchange="updateTotal()" id="quantity">
            <% (1..[max_qty, 10].min).each do |q| %>
              <option value="<%= q %>"><%= q %></option>
            <% end %>
          </select>
        </div>

        <div>
          <label class="label">Adresse de livraison</label>
          <textarea name="delivery_address" rows="2" class="input min-h-[60px]"><%= current_user.address %></textarea>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="label">Latitude</label>
            <input type="number" step="any" name="delivery_latitude" value="<%= current_user.latitude %>" class="input">
          </div>
          <div>
            <label class="label">Longitude</label>
            <input type="number" step="any" name="delivery_longitude" value="<%= current_user.longitude %>" class="input">
          </div>
        </div>

        <div>
          <label class="label">Notes</label>
          <textarea name="notes" rows="2" class="input min-h-[60px]" placeholder="Instructions spéciales..."></textarea>
        </div>

        <div class="bg-muted rounded-lg p-4">
          <div class="flex justify-between text-lg font-bold">
            <span>Total</span>
            <span class="text-primary" id="total"><%= number_to_currency(@item.price, unit: "CFA", format: "%n %u") %></span>
          </div>
        </div>

        <button type="submit" class="btn btn-primary w-full btn-lg">
          <i class="fas fa-shopping-cart"></i> Commander
        </button>
      </form>
    </div>
  </div>
</div>

<script>
function updateTotal() {
  const qty = document.getElementById('quantity').value;
  const price = <%= @item.price %>;
  const total = (qty * price).toLocaleString('fr-FR');
  document.getElementById('total').textContent = total + ' CFA';
}
</script>
