<div class="max-w-lg mx-auto">
  <a href="/cooks/<%= @cook.id %>" class="text-orange-600 hover:underline mb-4 inline-block"><i class="fas fa-arrow-left"></i> Retour au profil</a>

  <div class="bg-white rounded-xl shadow-md overflow-hidden">
    <div class="bg-gradient-to-r from-orange-500 to-orange-700 p-6 text-white">
      <h1 class="text-xl font-bold">Commander chez <%= @cook.full_name %></h1>
      <p class="text-orange-100 text-sm"><i class="fas fa-map-marker-alt"></i> <%= @cook.address %></p>
    </div>

    <div class="p-6">
      <div class="border rounded-lg p-4 mb-6 bg-orange-50">
        <div class="flex justify-between items-start mb-2">
          <div>
            <h3 class="font-bold"><%= @item.name %></h3>
            <p class="text-sm text-gray-600"><%= @item.description %></p>
          </div>
          <span class="text-xs px-2 py-0.5 rounded-full font-medium
            <%= 'bg-yellow-100 text-yellow-800' if @item.is_a?(Meal) && @item.lunch? %>
            <%= 'bg-blue-100 text-blue-800' if @item.is_a?(Meal) && @item.dinner? %>
            <%= 'bg-pink-100 text-pink-800' if @item.is_a?(DailyProduct) && @item.petit_fours? %>
            <%= 'bg-green-100 text-green-800' if @item.is_a?(DailyProduct) && @item.plat_sale? %>
            <%= 'bg-yellow-100 text-yellow-800' if @item.is_a?(DailyProduct) && @item.gateaux? %>
          ">
            <% if @item.is_a?(Meal) %>
              <%= @item.lunch? ? "Déjeuner" : "Dîner" %>
            <% else %>
              <%= @item.category.humanize %>
            <% end %>
          </span>
        </div>
        <p class="text-lg font-bold text-orange-600"><%= number_to_currency(@item.price, unit: "CFA", format: "%n %u") %></p>
      </div>

      <form action="/clients/<%= @cook.id %>/order" method="post" class="space-y-4">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <input type="hidden" name="item_type" value="<%= params[:item_type] %>">
        <input type="hidden" name="item_id" value="<%= @item.id %>">

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Quantité</label>
          <% max_qty = @item.is_a?(DailyProduct) ? @item.quantity_available : (@item.portion_count || 10) %>
          <select name="quantity" class="w-full border rounded-lg px-3 py-2" onchange="updateTotal()" id="quantity">
            <% (1..[max_qty, 10].min).each do |q| %>
              <option value="<%= q %>"><%= q %></option>
            <% end %>
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Adresse de livraison</label>
          <textarea name="delivery_address" rows="2" class="w-full border rounded-lg px-3 py-2"><%= current_user.address %></textarea>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Latitude</label>
            <input type="number" step="any" name="delivery_latitude" value="<%= current_user.latitude %>"
                   class="w-full border rounded-lg px-3 py-2">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Longitude</label>
            <input type="number" step="any" name="delivery_longitude" value="<%= current_user.longitude %>"
                   class="w-full border rounded-lg px-3 py-2">
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Notes</label>
          <textarea name="notes" rows="2" class="w-full border rounded-lg px-3 py-2" placeholder="Instructions spéciales..."></textarea>
        </div>

        <div class="bg-gray-50 rounded-lg p-4">
          <div class="flex justify-between text-lg font-bold">
            <span>Total</span>
            <span class="text-orange-600" id="total"><%= number_to_currency(@item.price, unit: "CFA", format: "%n %u") %></span>
          </div>
        </div>

        <button type="submit" class="w-full bg-orange-600 text-white py-3 rounded-lg hover:bg-orange-700 font-bold text-lg">
          <i class="fas fa-shopping-cart"></i> Commander
        </button>
      </form>
    </div>
  </div>
</div>

<script>
function updateTotal() {
  const qty = document.getElementById('quantity').value;
  const price = <%= @item.price %>;
  const total = (qty * price).toLocaleString('fr-FR');
  document.getElementById('total').textContent = total + ' CFA';
}
</script>
