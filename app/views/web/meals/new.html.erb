<div class="max-w-lg mx-auto card p-6 md:p-8">
  <div class="card-header">
    <h1 class="heading-2"><i class="fas fa-plus-circle text-primary"></i> Nouveau plat</h1>
  </div>
  <div class="card-body">
    <% if @errors %>
      <div class="bg-destructive/10 text-destructive text-sm p-3 rounded-lg mb-4">
        <% @errors.each do |err| %><p class="text-sm"><i class="fas fa-exclamation-circle"></i> <%= err %></p><% end %>
      </div>
    <% end %>

    <form method="post" action="/meals" class="space-y-4">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
      <div>
        <label class="label">Nom du plat</label>
        <input type="text" name="name" required class="input">
      </div>
      <div>
        <label class="label">Description</label>
        <textarea name="description" rows="2" class="input min-h-[60px]"></textarea>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="label">Jour</label>
          <select name="day_of_week" required class="select">
            <% %w[monday tuesday wednesday thursday friday saturday sunday].each do |day| %>
              <option value="<%= day %>"><%= day.capitalize %></option>
            <% end %>
          </select>
        </div>
        <div>
          <label class="label">Type</label>
          <select name="meal_type" required class="select">
            <option value="lunch">Déjeuner</option>
            <option value="dinner">Dîner</option>
          </select>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="label">Prix (CFA)</label>
          <input type="number" name="price" step="100" min="100" required class="input">
        </div>
        <div>
          <label class="label">Nombre de parts</label>
          <input type="number" name="portion_count" min="1" value="5" class="input">
        </div>
      </div>
      <div class="flex items-center gap-2">
        <input type="checkbox" name="available" value="1" checked id="available" class="rounded">
        <label for="available" class="text-sm">Disponible</label>
      </div>
      <button type="submit" class="btn btn-primary w-full">
        <i class="fas fa-save"></i> Enregistrer
      </button>
    </form>
  </div>
</div>
