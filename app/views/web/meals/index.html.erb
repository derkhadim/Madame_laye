<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold"><i class="fas fa-calendar-week text-orange-600"></i> Plats de la semaine</h1>
  <a href="/meals/new" class="bg-orange-600 text-white px-4 py-2 rounded-lg hover:bg-orange-700">
    <i class="fas fa-plus"></i> Nouveau plat
  </a>
</div>

<div class="bg-white rounded-xl shadow overflow-hidden">
  <table class="w-full text-sm">
    <thead class="bg-gray-100">
      <tr>
        <th class="text-left p-3">Jour</th>
        <th class="text-left p-3">Type</th>
        <th class="text-left p-3">Nom</th>
        <th class="text-left p-3">Prix</th>
        <th class="text-left p-3">Parts</th>
        <th class="text-left p-3">Dispo</th>
        <th class="text-left p-3">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @meals.each do |meal| %>
        <tr class="border-b hover:bg-gray-50">
          <td class="p-3"><%= meal.day_of_week.capitalize %></td>
          <td class="p-3"><span class="text-xs px-2 py-0.5 rounded-full <%= meal.lunch? ? 'bg-yellow-100' : 'bg-blue-100' %>"><%= meal.meal_type %></span></td>
          <td class="p-3 font-medium"><%= meal.name %></td>
          <td class="p-3"><%= number_to_currency(meal.price, unit: "CFA", format: "%n %u") %></td>
          <td class="p-3"><%= meal.portion_count %></td>
          <td class="p-3">
            <% if meal.available? %>
              <span class="text-green-600"><i class="fas fa-check-circle"></i></span>
            <% else %>
              <span class="text-red-600"><i class="fas fa-times-circle"></i></span>
            <% end %>
          </td>
          <td class="p-3 flex gap-2">
            <a href="/meals/<%= meal.id %>/edit" class="text-blue-600 hover:underline"><i class="fas fa-edit"></i></a>
            <a href="/meals/<%= meal.id %>/delete" class="text-red-600 hover:underline"
               data-turbo-method="delete" data-confirm="Supprimer ?"><i class="fas fa-trash"></i></a>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
