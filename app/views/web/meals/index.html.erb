<div class="flex justify-between items-center mb-6">
  <h1 class="heading-2"><i class="fas fa-calendar-week text-primary"></i> Plats de la semaine</h1>
  <a href="/meals/new" class="btn btn-primary">
    <i class="fas fa-plus"></i> Nouveau plat
  </a>
</div>

<div class="table-container">
  <table>
    <thead>
      <tr>
        <th>Jour</th>
        <th>Type</th>
        <th>Nom</th>
        <th>Prix</th>
        <th>Parts</th>
        <th>Dispo</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @meals.each do |meal| %>
        <tr>
          <td><%= meal.day_of_week.capitalize %></td>
          <td><span class="badge <%= meal.lunch? ? 'badge-secondary' : 'badge-primary' %>"><%= meal.meal_type %></span></td>
          <td class="font-medium"><%= meal.name %></td>
          <td><%= number_to_currency(meal.price, unit: "CFA", format: "%n %u") %></td>
          <td><%= meal.portion_count %></td>
          <td>
            <% if meal.available? %>
              <span class="text-green-600"><i class="fas fa-check-circle"></i></span>
            <% else %>
              <span class="text-destructive"><i class="fas fa-times-circle"></i></span>
            <% end %>
          </td>
          <td class="flex gap-2">
            <a href="/meals/<%= meal.id %>/edit" class="text-primary hover:underline"><i class="fas fa-edit"></i></a>
            <a href="/meals/<%= meal.id %>/delete" class="text-destructive hover:underline"
               data-turbo-method="delete" data-confirm="Supprimer ?"><i class="fas fa-trash"></i></a>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
