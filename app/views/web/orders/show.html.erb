<div class="max-w-2xl mx-auto">
  <a href="/orders" class="text-primary hover:underline mb-4 inline-block"><i class="fas fa-arrow-left"></i> Retour</a>

  <div class="card overflow-hidden">
    <div class="bg-muted p-6">
      <div class="flex justify-between items-start">
        <div>
          <h1 class="heading-3">Commande #<%= @order.id %></h1>
          <p class="text-gray-500 text-sm"><%= l(@order.created_at, format: :long) %></p>
        </div>
        <span class="badge bg-white text-primary"><%= @order.status %></span>
      </div>
    </div>

    <div class="card-body space-y-6">
      <div class="grid md:grid-cols-2 gap-4">
        <div>
          <p class="text-gray-500 text-sm">Cuisinier</p>
          <p class="font-medium"><%= @order.cook.full_name %></p>
          <p class="text-sm"><%= @order.cook.phone_number %></p>
        </div>
        <div>
          <p class="text-gray-500 text-sm">Client</p>
          <p class="font-medium"><%= @order.customer.full_name %></p>
          <p class="text-sm"><%= @order.customer.phone_number %></p>
        </div>
      </div>

      <div>
        <p class="text-gray-500 text-sm mb-1">Adresse de livraison</p>
        <p class="font-medium"><%= @order.delivery_address %></p>
      </div>

      <% if @order.delivery_driver %>
        <div>
          <p class="text-gray-500 text-sm">Livreur</p>
          <p class="font-medium"><%= @order.delivery_driver.full_name %></p>
          <p class="text-sm"><%= @order.delivery_driver.phone_number %></p>
        </div>
      <% end %>

      <% if @order.notes.present? %>
        <div>
          <p class="text-gray-500 text-sm mb-1">Notes du client</p>
          <p class="text-foreground italic bg-muted p-3 rounded-lg"><%= @order.notes %></p>
        </div>
      <% end %>

      <div>
        <p class="text-gray-500 text-sm mb-2">Articles</p>
        <div class="divide-y">
          <% @order.order_items.each do |oi| %>
            <div class="flex justify-between py-2">
              <span><%= oi.quantity %>x <%= oi.item.try(:name) || "Article" %></span>
              <span class="font-medium"><%= number_to_currency(oi.unit_price * oi.quantity, unit: "CFA", format: "%n %u") %></span>
            </div>
          <% end %>
        </div>
        <div class="flex justify-between pt-3 border-t font-bold text-lg">
          <span>Total</span>
          <span class="text-primary"><%= number_to_currency(@order.total_amount, unit: "CFA", format: "%n %u") %></span>
        </div>
      </div>

      <div class="flex gap-3 flex-wrap">
        <% if current_user.cook? && @order.cook_id == current_user.id %>
          <% if @order.pending? %>
            <a href="/orders/<%= @order.id %>/accept" class="btn btn-sm" style="background-color:#16a34a;color:white;border:none">
              <i class="fas fa-check"></i> Accepter
            </a>
            <a href="/orders/<%= @order.id %>/cancel" class="btn btn-destructive btn-sm"
               data-confirm="Annuler cette commande ?">
              <i class="fas fa-times"></i> Refuser
            </a>
          <% elsif @order.accepted? %>
            <a href="/orders/<%= @order.id %>/assign" class="btn btn-sm" style="background-color:#9333ea;color:white;border:none">
              <i class="fas fa-truck"></i> Assigner un livreur
            </a>
          <% elsif @order.driver_assigned? %>
            <span class="badge badge-secondary py-2 px-3">
              <i class="fas fa-clock"></i> En attente d'acceptation du livreur
            </span>
          <% elsif @order.delivered? %>
            <a href="/orders/<%= @order.id %>/complete" class="btn btn-sm" style="background-color:#16a34a;color:white;border:none">
              <i class="fas fa-check-double"></i> Terminer
            </a>
            <a href="/orders/<%= @order.id %>/confirm_reception" class="btn btn-sm" style="background-color:#2563eb;color:white;border:none">
              <i class="fas fa-handshake"></i> Confirmer réception
            </a>
          <% end %>
        <% end %>
        <% if current_user.delivery_driver? && @order.delivery_driver_id == current_user.id && @order.driver_assigned? %>
          <a href="/orders/<%= @order.id %>/accept_delivery" class="btn btn-sm" style="background-color:#9333ea;color:white;border:none">
            <i class="fas fa-check-circle"></i> Accepter la mission
          </a>
        <% end %>
        <% if current_user.delivery_driver? && @order.delivery_driver_id == current_user.id && @order.in_delivery? %>
          <a href="/orders/<%= @order.id %>/mark_delivered" class="btn btn-sm" style="background-color:#16a34a;color:white;border:none">
            <i class="fas fa-check-circle"></i> Marquer livré
          </a>
        <% end %>
        <% if current_user.client? && @order.customer_id == current_user.id && @order.pending? %>
          <a href="/orders/<%= @order.id %>/cancel" class="btn btn-destructive btn-sm"
             data-confirm="Annuler cette commande ?">
            <i class="fas fa-times"></i> Annuler
          </a>
        <% end %>
      </div>
    </div>
  </div>
</div>
