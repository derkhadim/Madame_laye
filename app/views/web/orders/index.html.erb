<div class="flex justify-between items-center mb-6">
  <h1 class="heading-2"><i class="fas fa-shopping-cart text-primary"></i>
    <%= current_user.cook? ? "Commandes reçues" : current_user.delivery_driver? ? "Mes livraisons" : "Mes commandes" %>
  </h1>
</div>

<div class="table-container">
  <table>
    <thead>
      <tr>
        <th>#</th>
        <% unless current_user.cook? %><th>Cuisinier</th><% end %>
        <% unless current_user.client? %><th>Client</th><% end %>
        <th>Articles</th>
        <th>Total</th>
        <th>Statut</th>
        <th>Date</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @orders.each do |order| %>
        <tr>
          <td>#<%= order.id %></td>
          <% unless current_user.cook? %><td><%= order.cook.full_name %></td><% end %>
          <% unless current_user.client? %><td><%= order.customer.full_name %></td><% end %>
          <td><%= order.order_items.count %></td>
          <td class="font-medium"><%= number_to_currency(order.total_amount, unit: "CFA", format: "%n %u") %></td>
          <td>
            <span class="badge <%= 'badge-secondary' if order.pending? %><%= 'badge-primary' if order.accepted? %><%= 'badge-secondary' if order.in_delivery? %><%= 'badge-secondary' if order.delivered? %><%= 'badge-secondary' if order.completed? %><%= 'badge-destructive' if order.cancelled? %>"><%= order.status %></span>
          </td>
          <td class="text-gray-500"><%= l(order.created_at, format: :short) %></td>
          <td><a href="/orders/<%= order.id %>" class="text-primary hover:underline"><i class="fas fa-eye"></i></a></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
