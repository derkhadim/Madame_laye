<div class="max-w-md mx-auto mt-10 card p-6 md:p-8">
  <div class="card-header text-center pb-4">
    <h1 class="heading-2"><i class="fas fa-sign-in-alt text-primary"></i> Connexion</h1>
  </div>
  <div class="card-body">
    <form method="post" action="/login" class="space-y-4">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
      <div>
        <label class="label">Numéro de téléphone</label>
        <input type="tel" name="phone_number" required placeholder="221771234567" class="input">
      </div>
      <div>
        <label class="label">Mot de passe</label>
        <input type="password" name="password" required class="input">
      </div>
      <button type="submit" class="btn btn-primary w-full">
        <i class="fas fa-sign-in-alt"></i> Se connecter
      </button>
    </form>
  </div>
  <div class="card-footer text-center">
    <p class="text-gray-500 text-sm">
      Pas encore de compte ? <a href="/signup" class="text-primary hover:underline">S'inscrire</a>
    </p>
  </div>
</div>
