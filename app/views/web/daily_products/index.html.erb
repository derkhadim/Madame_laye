<div class="flex justify-between items-center mb-6">
  <h1 class="heading-2"><i class="fas fa-box text-primary"></i> Produits journaliers</h1>
  <a href="/daily_products/new" class="btn btn-primary">
    <i class="fas fa-plus"></i> Nouveau produit
  </a>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
  <% @products.each do |p| %>
    <div class="card p-6">
      <div class="flex justify-between items-start mb-2">
        <span class="badge <%= 'badge-secondary' if p.petit_fours? %><%= 'badge-primary' if p.plat_sale? %><%= 'badge-secondary' if p.gateaux? %>"><%= p.category %></span>
        <a href="/daily_products/<%= p.id %>/delete" class="text-destructive hover:text-destructive/80"
           data-turbo-method="delete" data-confirm="Supprimer ?"><i class="fas fa-trash"></i></a>
      </div>
      <h3 class="font-medium"><%= p.name %></h3>
      <p class="text-gray-500 text-sm"><%= p.description&.truncate(60) %></p>
      <div class="flex justify-between items-center mt-3 text-sm">
        <span class="font-bold text-primary"><%= number_to_currency(p.price, unit: "CFA", format: "%n %u") %></span>
        <span><%= p.quantity_available %> dispo</span>
      </div>
      <p class="text-xs text-gray-500 mt-1"><%= l(p.date, format: :long) %></p>
    </div>
  <% end %>
</div>
