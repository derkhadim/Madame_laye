<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold"><i class="fas fa-box text-orange-600"></i> Produits journaliers</h1>
  <a href="/daily_products/new" class="bg-orange-600 text-white px-4 py-2 rounded-lg hover:bg-orange-700">
    <i class="fas fa-plus"></i> Nouveau produit
  </a>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
  <% @products.each do |p| %>
    <div class="bg-white rounded-xl shadow p-4">
      <div class="flex justify-between items-start mb-2">
        <span class="text-xs px-2 py-0.5 rounded-full
          <%= 'bg-pink-100 text-pink-800' if p.petit_fours? %>
          <%= 'bg-green-100 text-green-800' if p.plat_sale? %>
          <%= 'bg-yellow-100 text-yellow-800' if p.gateaux? %>
        "><%= p.category %></span>
        <a href="/daily_products/<%= p.id %>/delete" class="text-red-500 hover:text-red-700"
           data-turbo-method="delete" data-confirm="Supprimer ?"><i class="fas fa-trash"></i></a>
      </div>
      <h3 class="font-medium"><%= p.name %></h3>
      <p class="text-sm text-gray-500"><%= p.description&.truncate(60) %></p>
      <div class="flex justify-between items-center mt-3 text-sm">
        <span class="font-bold text-orange-600"><%= number_to_currency(p.price, unit: "CFA", format: "%n %u") %></span>
        <span><%= p.quantity_available %> dispo</span>
      </div>
      <p class="text-xs text-gray-400 mt-1"><%= l(p.date, format: :long) %></p>
    </div>
  <% end %>
</div>
