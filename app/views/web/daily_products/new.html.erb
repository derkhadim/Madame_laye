<div class="max-w-lg mx-auto bg-white rounded-xl shadow-md p-8">
  <h1 class="text-2xl font-bold mb-6"><i class="fas fa-box-open text-orange-600"></i> Nouveau produit journalier</h1>

  <% if @errors %>
    <div class="bg-red-100 text-red-700 p-3 rounded-lg mb-4">
      <% @errors.each do |err| %><p class="text-sm"><i class="fas fa-exclamation-circle"></i> <%= err %></p><% end %>
    </div>
  <% end %>

  <form method="post" action="/daily_products" class="space-y-4">
    <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Nom</label>
      <input type="text" name="name" required class="w-full border rounded-lg px-3 py-2">
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
      <textarea name="description" rows="2" class="w-full border rounded-lg px-3 py-2"></textarea>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Catégorie</label>
      <select name="category" required class="w-full border rounded-lg px-3 py-2">
        <option value="petit_fours">Petits fours</option>
        <option value="plat_sale">Plat salé</option>
        <option value="gateaux">Gâteaux</option>
      </select>
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Prix (CFA)</label>
        <input type="number" name="price" step="100" min="100" required class="w-full border rounded-lg px-3 py-2">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Quantité</label>
        <input type="number" name="quantity_available" min="1" value="10" class="w-full border rounded-lg px-3 py-2">
      </div>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Date</label>
      <input type="date" name="date" value="<%= Date.current %>" required class="w-full border rounded-lg px-3 py-2">
    </div>
    <button type="submit" class="w-full bg-orange-600 text-white py-2 rounded-lg hover:bg-orange-700 font-medium">
      <i class="fas fa-save"></i> Enregistrer
    </button>
  </form>
</div>
