<div class="max-w-lg mx-auto card p-6 md:p-8">
  <div class="card-header">
    <h1 class="heading-2"><i class="fas fa-box-open text-primary"></i> Nouveau produit journalier</h1>
  </div>
  <div class="card-body">
    <% if @errors %>
      <div class="bg-destructive/10 text-destructive text-sm p-3 rounded-lg mb-4">
        <% @errors.each do |err| %><p class="text-sm"><i class="fas fa-exclamation-circle"></i> <%= err %></p><% end %>
      </div>
    <% end %>

    <form method="post" action="/daily_products" class="space-y-4">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
      <div>
        <label class="label">Nom</label>
        <input type="text" name="name" required class="input">
      </div>
      <div>
        <label class="label">Description</label>
        <textarea name="description" rows="2" class="input min-h-[60px]"></textarea>
      </div>
      <div>
        <label class="label">Catégorie</label>
        <select name="category" required class="select">
          <option value="petit_fours">Petits fours</option>
          <option value="plat_sale">Plat salé</option>
          <option value="gateaux">Gâteaux</option>
        </select>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="label">Prix (CFA)</label>
          <input type="number" name="price" step="100" min="100" required class="input">
        </div>
        <div>
          <label class="label">Quantité</label>
          <input type="number" name="quantity_available" min="1" value="10" class="input">
        </div>
      </div>
      <div>
        <label class="label">Date</label>
        <input type="date" name="date" value="<%= Date.current %>" required class="input">
      </div>
      <button type="submit" class="btn btn-primary w-full">
        <i class="fas fa-save"></i> Enregistrer
      </button>
    </form>
  </div>
</div>
