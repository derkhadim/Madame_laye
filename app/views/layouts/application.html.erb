<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= @page_title || "Madame Laye" %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <style>
    .flash { transition: opacity 0.5s; }
    .map-container { height: 400px; }
  </style>
</head>
<body class="bg-gray-50 min-h-screen flex flex-col">

  <nav class="bg-orange-600 text-white shadow-lg">
    <div class="max-w-7xl mx-auto px-4">
      <div class="flex justify-between items-center h-16">
        <div class="flex items-center gap-6">
          <a href="/" class="text-xl font-bold flex items-center gap-2">
            <i class="fas fa-utensils"></i> Madame Laye
          </a>
          <% if logged_in? %>
            <div class="hidden md:flex items-center gap-4 text-sm">
              <a href="/menus/search" class="hover:text-orange-200"><i class="fas fa-search"></i> Rechercher</a>
              <% if current_user.cook? %>
                <a href="/dashboard" class="hover:text-orange-200"><i class="fas fa-chart-pie"></i> Dashboard</a>
                <a href="/meals" class="hover:text-orange-200"><i class="fas fa-calendar-week"></i> Plats</a>
                <a href="/daily_products" class="hover:text-orange-200"><i class="fas fa-box"></i> Produits</a>
                <a href="/orders" class="hover:text-orange-200"><i class="fas fa-shopping-cart"></i> Commandes</a>
              <% elsif current_user.client? %>
                <a href="/menus/search" class="hover:text-orange-200"><i class="fas fa-search"></i> Rechercher</a>
                <a href="/orders" class="hover:text-orange-200"><i class="fas fa-shopping-cart"></i> Mes commandes</a>
              <% elsif current_user.delivery_driver? %>
                <a href="/deliveries" class="hover:text-orange-200"><i class="fas fa-truck"></i> Livraisons</a>
                <a href="/payments/balance" class="hover:text-orange-200"><i class="fas fa-wallet"></i> Solde</a>
              <% elsif current_user.admin? || current_user.supervisor? %>
                <a href="/admin" class="hover:text-orange-200"><i class="fas fa-chart-pie"></i> Dashboard</a>
                <a href="/orders" class="hover:text-orange-200"><i class="fas fa-shopping-cart"></i> Commandes</a>
                <a href="/admin/withdrawals" class="hover:text-orange-200"><i class="fas fa-money-bill-wave"></i> Retraits</a>
                <a href="/menus/search" class="hover:text-orange-200"><i class="fas fa-search"></i> Rechercher</a>
              <% end %>
            </div>
          <% end %>
        </div>
        <div class="flex items-center gap-3">
          <% if logged_in? %>
            <span class="text-sm hidden md:inline"><i class="fas fa-user"></i> <%= current_user.full_name %></span>
            <span class="text-xs bg-orange-700 px-2 py-1 rounded"><%= current_user.role %></span>
            <a href="/logout" class="bg-orange-700 hover:bg-orange-800 px-3 py-1 rounded text-sm">
              <i class="fas fa-sign-out-alt"></i>
            </a>
          <% else %>
            <a href="/login" class="hover:text-orange-200">Connexion</a>
            <a href="/signup" class="bg-orange-700 hover:bg-orange-800 px-3 py-1 rounded text-sm">Inscription</a>
          <% end %>
        </div>
      </div>
    </div>
  </nav>

  <% if flash[:notice] %>
    <div class="bg-green-100 border-b border-green-200 text-green-800 px-4 py-2 text-center flash" data-flash>
      <%= flash[:notice] %>
    </div>
  <% end %>
  <% if flash[:alert] %>
    <div class="bg-red-100 border-b border-red-200 text-red-800 px-4 py-2 text-center flash" data-flash>
      <%= flash[:alert] %>
    </div>
  <% end %>

  <main class="flex-1 max-w-7xl mx-auto w-full px-4 py-6">
    <%= yield %>
  </main>

  <footer class="bg-gray-800 text-gray-400 text-center py-4 text-sm">
    &copy; 2026 Madame Laye — Tous droits réservés
  </footer>

  <script>
    document.querySelectorAll('[data-flash]').forEach(el => {
      setTimeout(() => { el.style.opacity = '0'; setTimeout(() => el.remove(), 500) }, 4000)
    })
  </script>
</body>
</html>
