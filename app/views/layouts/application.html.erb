<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= @page_title || "Madame Laye" %></title>
  <%= stylesheet_link_tag "tailwind" %>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body class="min-h-screen flex flex-col bg-paper-white text-graphite antialiased">

  <header class="bg-white border-b border-border">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex justify-between items-center h-20 px-2">
        <div class="flex items-center gap-8">
          <a href="/" class="font-bold text-lg flex items-center gap-3">
            <i class="fas fa-utensils text-ember-orange"></i> Madame Laye
          </a>
          <% if logged_in? %>
            <nav class="hidden md:flex items-center gap-2">
              <a href="/menus/search" class="btn btn-ghost btn-sm"><i class="fas fa-search"></i> Rechercher</a>
              <% if current_user.cook? %>
                <a href="/dashboard" class="btn btn-ghost btn-sm"><i class="fas fa-chart-pie"></i> Dashboard</a>
                <a href="/meals" class="btn btn-ghost btn-sm"><i class="fas fa-calendar-week"></i> Plats</a>
                <a href="/daily_products" class="btn btn-ghost btn-sm"><i class="fas fa-box"></i> Produits</a>
                <a href="/orders" class="btn btn-ghost btn-sm"><i class="fas fa-shopping-cart"></i> Commandes</a>
              <% elsif current_user.client? %>
                <a href="/orders" class="btn btn-ghost btn-sm"><i class="fas fa-shopping-cart"></i> Mes commandes</a>
              <% elsif current_user.delivery_driver? %>
                <a href="/deliveries" class="btn btn-ghost btn-sm"><i class="fas fa-truck"></i> Livraisons</a>
                <a href="/payments/balance" class="btn btn-ghost btn-sm"><i class="fas fa-wallet"></i> Solde</a>
              <% elsif current_user.admin? || current_user.supervisor? %>
                <a href="/admin" class="btn btn-ghost btn-sm"><i class="fas fa-chart-pie"></i> Dashboard</a>
                <a href="/orders" class="btn btn-ghost btn-sm"><i class="fas fa-shopping-cart"></i> Commandes</a>
                <a href="/admin/withdrawals" class="btn btn-ghost btn-sm"><i class="fas fa-money-bill-wave"></i> Retraits</a>
                <a href="/menus/search" class="btn btn-ghost btn-sm"><i class="fas fa-search"></i> Rechercher</a>
              <% end %>
            </nav>
          <% end %>
        </div>
        <div class="flex items-center gap-4">
          <% if logged_in? %>
            <span class="text-sm text-gray-500 hidden md:inline"><i class="fas fa-user"></i> <%= current_user.full_name %></span>
            <span class="badge badge-secondary"><%= current_user.role %></span>
            <a href="/logout" class="btn btn-ghost btn-sm">
              <i class="fas fa-sign-out-alt"></i>
            </a>
          <% else %>
            <a href="/login" class="btn btn-ghost btn-sm">Connexion</a>
            <a href="/signup" class="btn btn-primary btn-sm">Inscription</a>
          <% end %>
        </div>
      </div>
    </div>
  </header>

  <% if flash[:notice] %>
    <div class="bg-verdant-green/[0.08] border-b border-verdant-green/20 text-verdant-green px-6 py-3 text-sm text-center" data-flash>
      <i class="fas fa-check-circle"></i> <%= flash[:notice] %>
    </div>
  <% end %>
  <% if flash[:alert] %>
    <div class="bg-alert-red/[0.08] border-b border-alert-red/20 text-alert-red px-6 py-3 text-sm text-center" data-flash>
      <i class="fas fa-exclamation-circle"></i> <%= flash[:alert] %>
    </div>
  <% end %>

  <main class="flex-1 max-w-7xl mx-auto w-full px-6 py-8">
    <%= yield %>
  </main>

  <footer class="border-t border-border py-8 text-center text-sm text-gray-500">
    &copy; 2026 Madame Laye — Tous droits réservés
  </footer>

  <script>
    document.querySelectorAll('[data-flash]').forEach(el => {
      setTimeout(() => { el.style.opacity = '0'; setTimeout(() => el.remove(), 500) }, 4000)
    })
  </script>
</body>
</html>
